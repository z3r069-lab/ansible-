# ETCD Configuration - Generated by Ansible
ETCD_NAME="{{ etcd_name }}"
ETCD_DATA_DIR="{{ etcd_data_dir | default('/var/lib/etcd') }}"
ETCD_INITIAL_CLUSTER="{% for host in etcd_cluster_members %}{{ host.name }}={{ host.peer_url }}{% if not loop.last %},{% endif %}{% endfor %}"
ETCD_INITIAL_CLUSTER_STATE="{{ etcd_initial_cluster_state | default('new') }}"
ETCD_INITIAL_CLUSTER_TOKEN="{{ etcd_cluster_token | default('etcd-cluster') }}"
ETCD_INITIAL_ADVERTISE_PEER_URLS="{{ etcd_peer_url }}"
ETCD_LISTEN_PEER_URLS="{{ etcd_listen_peer_urls | default('https://0.0.0.0:2380') }}"
ETCD_LISTEN_CLIENT_URLS="{{ etcd_listen_client_urls | default('https://0.0.0.0:2379') }}"
ETCD_ADVERTISE_CLIENT_URLS="{{ etcd_client_url }}"
ETCD_CLIENT_CERT_AUTH="{{ etcd_client_cert_auth | default('true') }}"
ETCD_TRUSTED_CA_FILE="{{ etcd_trusted_ca_file | default('/etc/etcd/ssl/ca.crt') }}"
ETCD_CERT_FILE="{{ etcd_cert_file }}"
ETCD_KEY_FILE="{{ etcd_key_file }}"
ETCD_PEER_CLIENT_CERT_AUTH="{{ etcd_peer_client_cert_auth | default('true') }}"
ETCD_PEER_TRUSTED_CA_FILE="{{ etcd_peer_trusted_ca_file | default('/etc/etcd/ssl/ca.crt') }}"
ETCD_PEER_CERT_FILE="{{ etcd_peer_cert_file }}"
ETCD_PEER_KEY_FILE="{{ etcd_peer_key_file }}"